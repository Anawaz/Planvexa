# Planvexa local development environment.
# Copy to .env or map these values into your app host/user secrets as needed.

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Planvexa=Host=localhost;Port=5432;Database=planvexa;Username=planvexa;Password=planvexa

# Keycloak realm: http://localhost:8081/realms/planvexa
Keycloak__Authority=http://localhost:8081/realms/planvexa
Keycloak__Audience=planvexa-api
Keycloak__ClientId=planvexa-web
# JWT metadata over plain HTTP. Defaults to false in Development and true everywhere else; set it
# explicitly (Authentication__RequireHttpsMetadata=false) for containers that point at a plain-HTTP
# authority, instead of pretending the container is a Development environment.
Authentication__RequireHttpsMetadata=false

# OpenTelemetry traces to local Jaeger OTLP gRPC collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Local SMTP sink (Mailpit)
Smtp__Host=localhost
Smtp__Port=1025

# First-run bootstrap: on a database with no workspaces the API creates this admin user and one
# workspace so a fresh install is usable immediately (see PlanvexaBootstrap). Skipped in Development,
# where Database__SeedDevelopmentData already provisions users and workspaces. AdminSubject must match
# the 'sub' of the matching Keycloak account -- scripts/keycloak-bootstrap.ps1 creates one from
# BOOTSTRAP_ADMIN_SUBJECT / BOOTSTRAP_ADMIN_EMAIL / BOOTSTRAP_ADMIN_PASSWORD.
Bootstrap__Enabled=true
Bootstrap__AdminSubject=planvexa-admin
Bootstrap__AdminEmail=admin@planvexa.local
Bootstrap__AdminDisplayName=Planvexa Admin
Bootstrap__WorkspaceName=Planvexa

# Privileged connection for cross-tenant background work (outbox, notifications, recurring,
# export/retention sweeps). Optional: unset falls back to ConnectionStrings__Planvexa.
# The role needs LOGIN + BYPASSRLS; scripts/dev-up.ps1 provisions it when PLANVEXA_ADMIN_CONNECTION_STRING is set.
ConnectionStrings__PlanvexaMaintenance=Host=localhost;Port=5432;Database=planvexa;Username=planvexa_maint;Password=planvexa_maint
