<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>planvexa-apphost</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\api\Planvexa.Api\Planvexa.Api.csproj" />
  </ItemGroup>

  <!-- Plain Microsoft.NET.Sdk does not treat appsettings as content; the dev connection strings must
       reach the output directory as well as the project directory. -->
  <ItemGroup>
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

